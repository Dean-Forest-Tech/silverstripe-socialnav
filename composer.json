{
  "name": "dft/silverstripe-socialnav",
  "description": "Adds a list of social media services that generates a list of links in a template",
    "type": "silverstripe-vendormodule",
    "homepage": "http://github.com/Dean-Forest-Tech/silverstripe-socialnav",
    "keywords": [
        "silverstripe",
        "social",
        "Facebook",
        "Instagram",
        "twitter",
        "X.com",
        "Pinterest",
        "YouTube",
        "LinkedIn"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Dean Forest Tech",
            "homepage": "https://dean-forest-tech.uk"
        }
    ],
    "support": {
        "issues": "http://github.com/Dean-Forest-Tech/silverstripe-socialnav/issues"
    },
    "require": {
        "silverstripe/framework": "^4 || ^5"
    },
    "autoload": {
        "psr-4": {
            "DFT\\SilverStripe\\SocialNav\\": "src/"
        }
    },
    "extra": {
        "expose": [
            "images"
        ]
    }
}
